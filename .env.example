# Artemis UI configuration.
#
# The base URL of the Artemis REST API this console manages. When unset, the UI
# falls back to built-in fixtures (see src/lib/api/fixtures.ts) so it runs and
# builds before a live Artemis is reachable.
#
# Artemis exposes no auth today (single-user homelab); the UI sends no
# credentials. It talks REST/JSON and consumes HTTP media URLs (Apollo
# derivatives via the Artemis media gateway) — never gRPC.
#
# Example (in-cluster service DNS):
#   NEXT_PUBLIC_ARTEMIS_BASE_URL=http://artemis.artemis.svc.cluster.local:8080
# Example (via the Artemis API host behind Traefik):
#   NEXT_PUBLIC_ARTEMIS_BASE_URL=https://api.artemis.homelab
NEXT_PUBLIC_ARTEMIS_BASE_URL=
